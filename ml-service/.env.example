# Salin file ini ke .env, lalu isi nilainya.
# File .env JANGAN di-commit ke Git (sudah ada di .gitignore).
#
# Cara pakai:
#   Windows PowerShell :  Get-Content .env | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
#   Linux / macOS      :  export $(cat .env | xargs)

# URL project Supabase (dari Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co

# Service role key - berawalan sb_secret_ atau "service_role"
# JANGAN gunakan anon key: perlu hak tulis ke forecasts & forecast_details
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
